# Configuração Opcional de Servidor SMTP para Disparo Real de Alertas de Manutenção (PCM)
# Se deixado em branco, o sistema opera automaticamente no modo SIMULATED_INBOX,
# gravando todos os e-mails disparados na tabela email_alert_logs do SQLite.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_aqui
ALERT_EMAIL_TO=manutencao.pcm@industria-senai.com.br
